              <div class="g-spin" style="--phase:.25"><span class="g-sat"><i class="d-fill"></i><b>JavaScript</b></span></div>
              <div class="g-spin" style="--phase:.5"><span class="g-sat"><i class="d-fill"></i><b>TypeScript</b></span></div>
              <div class="g-spin" style="--phase:.75"><span class="g-sat"><i class="d-fill"></i><b>SQL</b></span></div>
            </div>

            <div class="g-ring" style="--d:54%; --t:42s;">
              <div class="g-spin" style="--phase:0"><span class="g-sat"><i class="d-hollow"></i><b>Gin</b></span></div>
              <div class="g-spin" style="--phase:.2"><span class="g-sat"><i class="d-hollow"></i><b>REST API</b></span></div>
              <div class="g-spin" style="--phase:.4"><span class="g-sat"><i class="d-hollow"></i><b>Clean Architecture</b></span></div>
              <div class="g-spin" style="--phase:.6"><span class="g-sat"><i class="d-hollow"></i><b>Hexagonal Architecture</b></span></div>
              <div class="g-spin" style="--phase:.8"><span class="g-sat"><i class="d-hollow"></i><b>Swagger / OpenAPI</b></span></div>
            </div>

            <div class="g-ring" style="--d:76%; --t:60s;">
              <div class="g-spin" style="--phase:0"><span class="g-sat"><i class="d-ring"></i><b>PostgreSQL</b></span></div>
              <div class="g-spin" style="--phase:.111"><span class="g-sat"><i class="d-ring"></i><b>MariaDB</b></span></div>
              <div class="g-spin" style="--phase:.222"><span class="g-sat"><i class="d-ring"></i><b>MySQL</b></span></div>
              <div class="g-spin" style="--phase:.333"><span class="g-sat"><i class="d-ring"></i><b>MongoDB</b></span></div>
              <div class="g-spin" style="--phase:.444"><span class="g-sat"><i class="d-ring"></i><b>Redis</b></span></div>
              <div class="g-spin" style="--phase:.555"><span class="g-sat"><i class="d-ring"></i><b>RabbitMQ</b></span></div>
              <div class="g-spin" style="--phase:.666"><span class="g-sat"><i class="d-ring"></i><b>Docker</b></span></div>
              <div class="g-spin" style="--phase:.777"><span class="g-sat"><i class="d-ring"></i><b>Grafana</b></span></div>
              <div class="g-spin" style="--phase:.888"><span class="g-sat"><i class="d-ring"></i><b>Git</b></span></div>
            </div>

            <div class="g-ring" style="--d:98%; --t:82s;">
              <div class="g-spin" style="--phase:0"><span class="g-sat"><i class="d-dim"></i><b>Meta Marketing API</b></span></div>
              <div class="g-spin" style="--phase:.25"><span class="g-sat"><i class="d-dim"></i><b>Xendit</b></span></div>
              <div class="g-spin" style="--phase:.5"><span class="g-sat"><i class="d-dim"></i><b>Midtrans</b></span></div>
              <div class="g-spin" style="--phase:.75"><span class="g-sat"><i class="d-dim"></i><b>Stripe</b></span></div>
            </div>
          </div>
          <ul class="g-legend">
            <li><i class="d-fill"></i> Languages</li>
            <li><i class="d-hollow"></i> Backend &amp; APIs</li>
            <li><i class="d-ring"></i> Databases &amp; Infra</li>
            <li><i class="d-dim"></i> Integrations</li>
          </ul>
        </div>

        <div class="skills-grid skills-fallback">
          <div class="card reveal">
            <h3>Languages</h3>
            <div><span class="tag">Go (Golang)</span><span class="tag">JavaScript</span><span class="tag">TypeScript</span><span class="tag">SQL</span></div>
          </div>
          <div class="card reveal">
            <h3>Backend & APIs</h3>
            <div><span class="tag">Gin</span><span class="tag">REST API</span><span class="tag">Clean Architecture</span><span class="tag">Hexagonal Architecture</span><span class="tag">Swagger / OpenAPI</span></div>
          </div>
          <div class="card reveal">
            <h3>Databases & Infra</h3>
            <div><span class="tag">PostgreSQL</span><span class="tag">MariaDB</span><span class="tag">MySQL</span><span class="tag">MongoDB</span><span class="tag">Redis</span><span class="tag">RabbitMQ</span><span class="tag">Docker</span><span class="tag">Grafana</span><span class="tag">Git</span></div>
          </div>
          <div class="card reveal">
            <h3>Integrations</h3>
            <div><span class="tag">Meta Marketing API</span><span class="tag">Xendit</span><span class="tag">Midtrans</span><span class="tag">Stripe</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. EDUCATION & MORE -->
    <section id="education" class="block">
      <div class="container">
        <p class="eyebrow reveal">Education & More</p>
        <h2 class="section-title reveal">Background.</h2>

        <div class="edu-grid">
          <article class="card reveal">
            <p class="eyebrow">2022 — 2026</p>
            <h3>Bachelor of Informatics</h3>
            <p class="job-org">Universitas Amikom Yogyakarta</p>
            <p class="card-text">GPA 3.78 / 4.00</p>
          </article>

          <article class="card reveal">
            <p class="eyebrow">Publication · Dec 2025</p>
            <h3>JAIC (Sinta 3)</h3>
            <p class="card-text">
              Comparative Analysis of EfficientNet-B0 and ViT-B16 for Multiclass
              Classification of Green Coffee Beans. EfficientNet-B0 reached 87%
              accuracy with 0.035s single-image inference.
            </p>
          </article>

          <article class="card reveal">
            <p class="eyebrow">Certifications</p>
            <h3>Always learning</h3>
            <ul class="job-list">
              <li>Fullstack Software Development — ProductZilla Academy (MSIB), 2024</li>
              <li>Junior Web Developer — Digital Talent Scholarship (VSGA), 2023</li>
              <li>Golang Developer — Udemy, 2025</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 7. CONTACT -->
    <section id="contact" class="block contact-block">
      <div class="container contact-inner reveal">
        <p class="eyebrow">Contact</p>
        <h2 class="section-title">Let's build something<br />reliable together.</h2>
        <p class="section-sub">
          Currently open to backend engineering roles and interesting collaborations.
          The fastest way to reach me is email — I reply within a day.
        </p>
        <div class="hero-actions">
          <a href="mailto:muhrezkysyaputra100@gmail.com" class="btn btn-solid">muhrezkysyaputra100@gmail.com</a>
        </div>
        <div class="social-row">
          <a href="https://www.linkedin.com/in/muhrezkysyaputra" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
          <a href="https://github.com/rezkysyaputra" target="_blank" rel="noopener noreferrer">GitHub →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>© 2026 Muh. Rezky Syaputra. Built with Astro & Three.js.</p>
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/muhrezkysyaputra" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/rezkysyaputra" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:muhrezkysyaputra100@gmail.com">Email</a>
      </div>
    </div>
  </footer>

  <script>
    // Lazy-load the 3D planet only when the hero is visible.
    const canvas = document.getElementById('planet-canvas');
    if (canvas) {
      const load = async () => {
        try {
          const { initPlanet } = await import('../scripts/planet.js');
          await initPlanet(canvas);
        } catch (e) {
          console.warn('3D planet failed to load, hero stays static.', e);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) {
            obs.disconnect();
            // wait a beat so first paint isn't blocked
            setTimeout(load, 350);
          }
        });
        io.observe(canvas);
      } else {
        load();
      }
    }

    // Mobile menu toggle
    const toggle = document.querySelector('.nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (toggle && mobileMenu) {
      toggle.addEventListener('click', () => {
        const open = mobileMenu.classList.toggle('open');
        toggle.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      mobileMenu.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          toggle.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
        });
      });
    }
  </script>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 68px;
  }
  #planet-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: pan-y;
  }
  #planet-canvas:active { cursor: grabbing; }
  .hero-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(5,5,5,0.55) 0%, rgba(5,5,5,0) 26%, rgba(5,5,5,0) 62%, var(--bg) 100%),
      linear-gradient(to right, rgba(5,5,5,0.72) 0%, rgba(5,5,5,0.25) 46%, rgba(5,5,5,0) 72%);
  }
  .hero-content { position: relative; z-index: 2; max-width: var(--max-w); pointer-events: none; }
  .hero-content a { pointer-events: auto; }
  /* Centered hero text on tablet/desktop, left-aligned on mobile */
  @media (min-width: 720px) {
    .hero-content { text-align: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    .hero-fade {
      background:
        radial-gradient(ellipse 78% 62% at 50% 42%, rgba(5,5,5,0.8) 0%, rgba(5,5,5,0.38) 55%, rgba(5,5,5,0) 78%),
        linear-gradient(to bottom, rgba(5,5,5,0.5) 0%, rgba(5,5,5,0) 30%, rgba(5,5,5,0) 60%, var(--bg) 100%);
    }
  }
  .hero h1 {
    font-size: clamp(3rem, 8.5vw, 6.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin-bottom: 24px;
  }
  /* One-line name on tablet/desktop */
  @media (min-width: 720px) {
    .hero h1 { font-size: clamp(2rem, 5.6vw, 4.2rem); white-space: nowrap; }
    .hero h1 br { display: none; }
  }
  .hero-sub {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--muted);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 36px;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .hero-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--faint);
    opacity: 0.8;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .hero-hint { display: none; }
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 8px;
  }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }

  /* TIMELINE / JOBS */
  .timeline { display: grid; gap: 24px; margin-top: 40px; }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .job-head h3 { font-size: 1.35rem; letter-spacing: -0.02em; margin-bottom: 4px; }
  .job-org { color: var(--muted); }
  .job-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--faint);
    border: 1px solid var(--border);
    padding: 6px 14px;
    white-space: nowrap;
  }
  .job-list { list-style: none; display: grid; gap: 10px; margin-bottom: 20px; }
  .job-list li {
    color: var(--muted);
    line-height: 1.65;
    padding-left: 22px;
    position: relative;
    font-size: 0.98rem;
  }
  .job-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--faint);
  }

  /* PROJECTS */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
  .card h3 { font-size: 1.3rem; letter-spacing: -0.02em; margin-bottom: 12px; }
  .card-text { color: var(--muted); line-height: 1.7; margin-bottom: 24px; }
  .card-link {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #3a3a3a;
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }
  .card-link:hover { border-color: #fff; }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 760px) { .skills-grid { grid-template-columns: 1fr; } }
  .skills-grid .card h3 { margin-bottom: 20px; }

  /* SKILL GALAXY — animated orbit map (tablet/desktop) */
  .galaxy-wrap { margin-top: 48px; }
  .galaxy {
    position: relative;
    width: min(700px, 100%);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .g-core {
    position: absolute;
    left: 50%; top: 50%;
    width: 92px; height: 92px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #2e2e2e, #0a0a0a 72%);
    border: 1px solid #3d3d3d;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 70px rgba(255,255,255,0.09);
  }
  .g-core span {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.12em;
    font-size: 1.05rem;
  }
  .g-ring {
    position: absolute;
    left: 50%; top: 50%;
    width: var(--d);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 50%;
  }
  .g-spin {
    position: absolute;
    inset: 0;
    animation: g-spin var(--t) linear infinite;
    animation-delay: calc(var(--t) * var(--phase) * -1);
  }
  .g-sat { position: absolute; top: 0; left: 50%; width: 0; height: 0; }
  .g-sat i {
    position: absolute;
    left: -7px; top: -7px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgba(255,255,255,0.5);
  }
  .g-sat i.d-hollow { background: transparent; border: 2px solid #fff; box-shadow: none; }
  .g-sat i.d-dim { background: #8a8a8a; box-shadow: 0 0 10px rgba(255,255,255,0.25); }
  .g-sat i.d-ring { box-shadow: 0 0 0 4px rgba(255,255,255,0.18), 0 0 12px rgba(255,255,255,0.4); }
  .g-sat b {
    position: absolute;
    left: 14px; top: -10px;
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    color: #d4d4d4;
    animation: g-spin var(--t) linear infinite reverse;
