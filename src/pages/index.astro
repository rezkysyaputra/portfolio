---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- NAV -->
  <header class="nav">
    <div class="nav-inner">
      <a href="#top" class="nav-brand">REZKY<span>.DEV</span></a>
      <nav class="nav-links">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- 1. HERO -->
    <section class="hero">
      <canvas id="planet-canvas" aria-hidden="true"></canvas>
      <div class="hero-fade" aria-hidden="true"></div>
      <div class="container hero-content">
        <p class="eyebrow reveal">Backend Engineer · Go (Golang)</p>
        <h1 class="reveal">Muh. Rezky<br />Syaputra</h1>
        <p class="hero-sub reveal">
          I build backend systems that move money and ads — payment workflows,
          ad-platform automation, and production-grade REST APIs in Go.
        </p>
        <div class="hero-actions reveal">
          <a href="/cv.pdf" class="btn btn-solid" download>Download CV</a>
          <a href="mailto:muhrezkysyaputra100@gmail.com" class="btn btn-ghost">Get in touch</a>
        </div>
        <p class="hero-meta reveal">Purbalingga, Indonesia · Open to work</p>
        <p class="hero-hint" aria-hidden="true">drag the planet ⟳</p>
      </div>
    </section>

    <!-- 2. ABOUT -->
    <section id="about" class="block">
      <div class="container">
        <p class="eyebrow reveal">About</p>
        <h2 class="section-title reveal">Backend is where<br />I live.</h2>
        <div class="about-grid">
          <p class="section-sub reveal">
            Backend Engineer with hands-on experience building and maintaining backend
            services in Go for digital advertising and financial automation platforms.
            I work across the stack where it matters: Meta Marketing API integrations,
            payment and disbursement workflows, Redis caching, RabbitMQ messaging,
            and PostgreSQL/MariaDB — with Grafana keeping an eye on production.
          </p>
          <p class="section-sub reveal">
            I care about systems that are boring in the best way: well-architected,
            observable, and reliable under real traffic. Clean Architecture and
            Hexagonal Architecture aren't buzzwords to me — they're how I keep
            a payment service maintainable when the third provider gets plugged in.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. EXPERIENCE -->
    <section id="experience" class="block">
      <div class="container">
        <p class="eyebrow reveal">Experience</p>
        <h2 class="section-title reveal">Where I've worked.</h2>

        <div class="timeline">
          <article class="card reveal">
            <div class="job-head">
              <div>
                <h3>Backend Developer</h3>
                <p class="job-org">Komads-Komerce Ecosystem</p>
              </div>
              <span class="job-date">Feb 2026 — Present</span>
            </div>
            <ul class="job-list">
              <li>Develop and maintain backend services for a digital advertising platform with Go, Gin, REST API, MariaDB, and PostgreSQL.</li>
              <li>Integrate the Meta Marketing API to automate ad account management, account synchronization, balance monitoring, and advertising operations.</li>
              <li>Build automated payment and disbursement workflows for advertising platforms, integrating services such as Xendit.</li>
              <li>Implement RabbitMQ-based async processing and Redis caching for background jobs and responsiveness.</li>
              <li>Monitor and troubleshoot production services with Grafana, logs, and application-level validation.</li>
            </ul>
            <div class="job-tags">
              <span class="tag">Go</span><span class="tag">Gin</span><span class="tag">PostgreSQL</span><span class="tag">MariaDB</span><span class="tag">Redis</span><span class="tag">RabbitMQ</span><span class="tag">Meta Marketing API</span><span class="tag">Xendit</span><span class="tag">Grafana</span><span class="tag">Docker</span>
            </div>
          </article>

          <article class="card reveal">
            <div class="job-head">
              <div>
                <h3>Fullstack Software Development</h3>
                <p class="job-org">ProductZilla Academy</p>
              </div>
              <span class="job-date">Sep 2024 — Dec 2024</span>
            </div>
            <ul class="job-list">
              <li>Completed an industry-oriented fullstack program: MERN stack, REST APIs, database design, Git, Docker, and software engineering best practices.</li>
              <li>Built a production-like capstone in an Agile team with React.js, Node.js, Express.js, and MongoDB.</li>
              <li>Developed backend REST APIs, integrated third-party services, and documented APIs with Swagger/OpenAPI.</li>
            </ul>
            <div class="job-tags">
              <span class="tag">React</span><span class="tag">Node.js</span><span class="tag">Express</span><span class="tag">MongoDB</span><span class="tag">Swagger</span><span class="tag">Docker</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. PROJECTS -->
    <section id="projects" class="block">
      <div class="container">
        <p class="eyebrow reveal">Projects</p>
        <h2 class="section-title reveal">Things I've built.</h2>

        <div class="project-grid">
          <article class="card reveal">
            <p class="eyebrow">Go · Gin · PostgreSQL · Redis · Docker</p>
            <h3>Payment Aggregator Service</h3>
            <p class="card-text">
              A unified payment gateway service integrating Midtrans, Xendit, and Stripe
              through one standardized REST API. Hexagonal Architecture keeps each
              provider swappable; webhook idempotency and Redis caching keep money
              movement reliable.
            </p>
            <a class="card-link" href="https://github.com/rezkysyaputra/go-payment-aggregator" target="_blank" rel="noopener noreferrer">
              View on GitHub →
            </a>
          </article>

          <article class="card reveal">
            <p class="eyebrow">Node.js · Express · TypeScript · MongoDB</p>
            <h3>Water Delivery API</h3>
            <p class="card-text">
              REST APIs for customer orders, delivery management, and Midtrans payment
              integration. Documented with Swagger/OpenAPI and covered by integration
              tests — 90.64% code coverage with Jest and Supertest.
            </p>
            <a class="card-link" href="https://github.com/rezkysyaputra" target="_blank" rel="noopener noreferrer">
              View on GitHub →
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- 5. SKILLS -->
    <section id="skills" class="block">
      <div class="container">
        <p class="eyebrow reveal">Skills</p>
        <h2 class="section-title reveal">My toolbox.</h2>

        <div class="skills-grid">
          <div class="card reveal">
            <h3>Languages</h3>
            <div><span class="tag">Go (Golang)</span><span class="tag">JavaScript</span><span class="tag">TypeScript</span><span class="tag">SQL</span></div>
          </div>
          <div class="card reveal">
            <h3>Backend & APIs</h3>
            <div><span class="tag">Gin</span><span class="tag">REST API</span><span class="tag">Clean Architecture</span><span class="tag">Hexagonal Architecture</span><span class="tag">Swagger / OpenAPI</span></div>
          </div>
          <div class="card reveal">
            <h3>Databases & Infra</h3>
            <div><span class="tag">PostgreSQL</span><span class="tag">MariaDB</span><span class="tag">MySQL</span><span class="tag">MongoDB</span><span class="tag">Redis</span><span class="tag">RabbitMQ</span><span class="tag">Docker</span><span class="tag">Grafana</span><span class="tag">Git</span></div>
          </div>
          <div class="card reveal">
            <h3>Integrations</h3>
            <div><span class="tag">Meta Marketing API</span><span class="tag">Xendit</span><span class="tag">Midtrans</span><span class="tag">Stripe</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. EDUCATION & MORE -->
    <section id="education" class="block">
      <div class="container">
        <p class="eyebrow reveal">Education & More</p>
        <h2 class="section-title reveal">Background.</h2>

        <div class="edu-grid">
          <article class="card reveal">
            <p class="eyebrow">2022 — 2026</p>
            <h3>Bachelor of Informatics</h3>
            <p class="job-org">Universitas Amikom Yogyakarta</p>
            <p class="card-text">GPA 3.78 / 4.00</p>
          </article>

          <article class="card reveal">
            <p class="eyebrow">Publication · Dec 2025</p>
            <h3>JAIC (Sinta 3)</h3>
            <p class="card-text">
              Comparative Analysis of EfficientNet-B0 and ViT-B16 for Multiclass
              Classification of Green Coffee Beans. EfficientNet-B0 reached 87%
              accuracy with 0.035s single-image inference.
            </p>
          </article>

          <article class="card reveal">
            <p class="eyebrow">Certifications</p>
            <h3>Always learning</h3>
            <ul class="job-list">
              <li>Fullstack Software Development — ProductZilla Academy (MSIB), 2024</li>
              <li>Junior Web Developer — Digital Talent Scholarship (VSGA), 2023</li>
              <li>Golang Developer — Udemy, 2025</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 7. CONTACT -->
    <section id="contact" class="block contact-block">
      <div class="container contact-inner reveal">
        <p class="eyebrow">Contact</p>
        <h2 class="section-title">Let's build something<br />reliable together.</h2>
        <p class="section-sub">
          Currently open to backend engineering roles and interesting collaborations.
          The fastest way to reach me is email — I reply within a day.
        </p>
        <div class="hero-actions">
          <a href="mailto:muhrezkysyaputra100@gmail.com" class="btn btn-solid">muhrezkysyaputra100@gmail.com</a>
        </div>
        <div class="social-row">
          <a href="https://www.linkedin.com/in/muhrezkysyaputra" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
          <a href="https://github.com/rezkysyaputra" target="_blank" rel="noopener noreferrer">GitHub →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>© 2026 Muh. Rezky Syaputra. Built with Astro & Three.js.</p>
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/muhrezkysyaputra" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/rezkysyaputra" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:muhrezkysyaputra100@gmail.com">Email</a>
      </div>
    </div>
  </footer>

  <script>
    // Lazy-load the 3D planet only when the hero is visible.
    const canvas = document.getElementById('planet-canvas');
    if (canvas) {
      const load = async () => {
        try {
          const { initPlanet } = await import('../scripts/planet.js');
          await initPlanet(canvas);
        } catch (e) {
          console.warn('3D planet failed to load, hero stays static.', e);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) {
            obs.disconnect();
            // wait a beat so first paint isn't blocked
            setTimeout(load, 350);
          }
        });
        io.observe(canvas);
      } else {
        load();
      }
    }
  </script>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 68px;
  }
  #planet-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: pan-y;
  }
  #planet-canvas:active { cursor: grabbing; }
  .hero-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(5,5,5,0.55) 0%, rgba(5,5,5,0) 26%, rgba(5,5,5,0) 62%, var(--bg) 100%),
      linear-gradient(to right, rgba(5,5,5,0.72) 0%, rgba(5,5,5,0.25) 46%, rgba(5,5,5,0) 72%);
  }
  .hero-content { position: relative; z-index: 2; max-width: var(--max-w); }
  .hero h1 {
    font-size: clamp(3rem, 8.5vw, 6.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--muted);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 36px;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .hero-hint {
    position: absolute;
    bottom: 28px;
    right: 32px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--faint);
    opacity: 0.8;
  }
  @media (max-width: 760px) {
    .hero-hint { display: none; }
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 8px;
  }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }

  /* TIMELINE / JOBS */
  .timeline { display: grid; gap: 24px; margin-top: 40px; }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .job-head h3 { font-size: 1.35rem; letter-spacing: -0.02em; margin-bottom: 4px; }
  .job-org { color: var(--muted); }
  .job-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--faint);
    border: 1px solid var(--border);
    padding: 6px 14px;
    white-space: nowrap;
  }
  .job-list { list-style: none; display: grid; gap: 10px; margin-bottom: 20px; }
  .job-list li {
    color: var(--muted);
    line-height: 1.65;
    padding-left: 22px;
    position: relative;
    font-size: 0.98rem;
  }
  .job-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--faint);
  }

  /* PROJECTS */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
  .card h3 { font-size: 1.3rem; letter-spacing: -0.02em; margin-bottom: 12px; }
  .card-text { color: var(--muted); line-height: 1.7; margin-bottom: 24px; }
  .card-link {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #3a3a3a;
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }
  .card-link:hover { border-color: #fff; }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 760px) { .skills-grid { grid-template-columns: 1fr; } }
  .skills-grid .card h3 { margin-bottom: 20px; }

  /* EDUCATION */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 900px) { .edu-grid { grid-template-columns: 1fr; } }

  /* CONTACT */
  .contact-block { text-align: left; }
  .contact-inner .section-title { margin-bottom: 20px; }
  .contact-inner .section-sub { margin-bottom: 36px; }
  .social-row { display: flex; gap: 24px; margin-top: 28px; }
  .social-row a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid #3a3a3a;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .social-row a:hover { color: #fff; border-color: #fff; }
</style>
